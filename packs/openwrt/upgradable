#!/bin/sh
#: description = "Packages with a newer version in OpenWrt's feeds, after refreshing the lists (opkg, or apk from OpenWrt 25). Upgrading packages one by one can break a router: a new release goes through sysupgrade"
#: read_only = true
#: timeout = "5m"
#: [args.refresh]
#: type = "bool"
#: default = true
#: description = "Download the package lists first; they live in RAM and are gone after a reboot"
set -eu

if command -v apk > /dev/null 2>&1; then
  if [ "${LIMEN_ARG_REFRESH:-true}" = true ]; then
    apk update > /dev/null 2>&1 || { echo "apk update failed: are the feeds reachable? (system's reach)"; exit 1; }
  fi
  upgradable=$(apk list --upgradable 2> /dev/null) || true
elif command -v opkg > /dev/null 2>&1; then
  if [ "${LIMEN_ARG_REFRESH:-true}" = true ]; then
    opkg update > /dev/null 2>&1 || { echo "opkg update failed: are the feeds reachable? (system's reach)"; exit 1; }
  fi
  upgradable=$(opkg list-upgradable 2> /dev/null) || true
else
  echo "neither opkg nor apk is here"
  exit 1
fi

if [ "${LIMEN_ARG_REFRESH:-true}" = false ]; then
  echo "(from the package lists as they were; refresh to download them anew)"
fi
# shellcheck disable=SC1091 # the router's own file, not this repository's
release=$(. /etc/openwrt_release 2> /dev/null && echo "$DISTRIB_DESCRIPTION") || release="OpenWrt"
if [ -z "$upgradable" ]; then
  echo "$release: every package is up to date"
  exit 0
fi
echo "$release: $(printf '%s\n' "$upgradable" | wc -l) package(s) can be upgraded"
printf '%s\n' "$upgradable"
