#!/bin/sh
#: description = "The installed packages with their version and state (ii: installed; hi: held back; rc: removed, configuration left), or those matching a name pattern such as docker*"
#: read_only = true
#: [args.name]
#: type = "string"
#: default = "*"
#: pattern = '^[a-z0-9*?][a-z0-9+.*?-]{0,63}$'
#: description = "A package name, with * and ? as wildcards"
set -eu

# dpkg also remembers names it only heard of (state un): they are not installed.
installed=$(dpkg-query --show --showformat='${Package}\t${Version}\t${db:Status-Abbrev}\n' -- "$LIMEN_ARG_NAME" 2> /dev/null |
  awk -F '\t' '$3 !~ /^un/') || true
if [ -z "$installed" ]; then
  echo "no installed package matches $LIMEN_ARG_NAME"
  exit 0
fi
echo "$(printf '%s\n' "$installed" | wc -l) package(s)"
printf '%s\n' "$installed"
